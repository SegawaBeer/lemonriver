{
  "name": "@lemonriver/cli",
  "version": "0.1.1",
  "description": "Scaffold a LemonRiver workspace with Claude Code skills preconfigured.",
  "type": "module",
  "bin": {
    "lemonriver": "dist/cli.js",
    "open-slide": "dist/cli.js"
  },
  "files": [
    "dist",
    "template",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/sync-template-skills.mjs && tsdown",
    "typecheck": "tsc --noEmit",
    "sync:template-skills": "node scripts/sync-template-skills.mjs",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "keywords": [
    "slides",
    "presentation",
    "claude-code",
    "scaffold"
  ],
  "license": "MIT",
  "author": {
    "name": "SegawaBeer",
    "url": "https://github.com/SegawaBeer"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SegawaBeer/lemonriver.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/SegawaBeer/lemonriver/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "chalk": "^6.0.1",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  }
}
