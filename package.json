{
  "name": "lemonriver-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:demo": "turbo run dev --filter=demo",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:branding": "node scripts/check-branding.mjs",
    "upstream:check": "node scripts/upstream.mjs check",
    "upstream:merge": "node scripts/upstream.mjs merge",
    "test": "vitest run --project unit",
    "test:changelog": "vitest run --project changelog",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @lemonriver/core test:e2e",
    "core": "pnpm --filter @lemonriver/core",
    "cli": "pnpm --filter @lemonriver/cli",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=@lemonriver/core --filter=@lemonriver/cli && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^3.0.2",
    "turbo": "^2.11.7",
    "vitest": "^5.0.0"
  }
}
